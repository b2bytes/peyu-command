{
  "name": "Nueva Consulta \u00b7 notificar equipo",
  "description": "Cuando llega una Consulta nueva (chat p\u00fablico, WhatsApp, formulario, Instagram), notifica inmediatamente a ti@ y ventas@peyuchile.cl con detalle del mensaje y link directo a WhatsApp del prospecto.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Consulta"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nueva_consulta_notificar_equipo",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewConsulta",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyNewConsulta"
  }
}