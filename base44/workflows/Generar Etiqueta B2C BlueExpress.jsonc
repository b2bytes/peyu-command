{
  "name": "Generar Etiqueta B2C BlueExpress",
  "description": "Cuando un pedido B2C se confirma como pagado, genera autom\u00e1ticamente la etiqueta BlueExpress, crea el tracking y notifica al cliente",
  "trigger": {
    "condition": "${ ((.trigger.data.payment_status == \"paid\") and (.trigger.data.tracking == null or .trigger.data.tracking == \"\" or .trigger.data.tracking == [] or .trigger.data.tracking == {}) and (.trigger.old_data.payment_status != \"paid\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PedidoWeb"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generar_etiqueta_b2c_blueexpress",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generarEtiquetaB2CBlueExpress",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generarEtiquetaB2CBlueExpress"
  }
}