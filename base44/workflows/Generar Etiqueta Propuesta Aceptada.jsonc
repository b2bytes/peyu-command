{
  "name": "Generar Etiqueta Propuesta Aceptada",
  "description": "Cuando una propuesta se marca como Aceptada, genera autom\u00e1ticamente la etiqueta de env\u00edo BlueExpress, crea el registro de tracking y actualiza a Listo para Despacho",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Aceptada\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CorporateProposal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generar_etiqueta_propuesta_aceptada",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generarEtiquetaPropostaAceptada",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generarEtiquetaPropostaAceptada"
  }
}