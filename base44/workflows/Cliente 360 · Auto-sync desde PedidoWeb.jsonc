{
  "name": "Cliente 360 \u00b7 Auto-sync desde PedidoWeb",
  "description": "Cuando se crea o actualiza un PedidoWeb (con estado v\u00e1lido), recalcula el perfil del Cliente: total compras, num pedidos, ticket promedio, SKU favorito y estado (VIP/Activo/En Riesgo).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "PedidoWeb"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cliente_360_auto_sync_desde_pedidoweb",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncClienteFromPedido",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncClienteFromPedido"
  }
}