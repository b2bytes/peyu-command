{
  "name": "Auto-Index \u00b7 Producto publicado",
  "description": "Notifica a Google (sitemap ping) e IndexNow (Bing/Yandex/Seznam) cuando se publica o activa un producto, para acelerar la indexaci\u00f3n de la URL /producto/:id.",
  "trigger": {
    "condition": "${ (.trigger.data.activo == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Producto"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_index_producto_publicado",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoIndexOnPublish",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoIndexOnPublish"
  }
}