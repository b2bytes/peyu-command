{
  "name": "Alerta: Propuesta Urgente",
  "description": "Notifica al equipo cuando una propuesta cambia de estado o vence",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"Rechazada\") or (.trigger.data.status == \"Vencida\") or (.trigger.data.status == \"Expirada\") or (.trigger.data.status == \"Aceptada\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "CorporateProposal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alerta_propuesta_urgente",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarPropuestaUrgente",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notificarPropuestaUrgente"
  }
}