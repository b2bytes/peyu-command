{
  "name": "IA \u00b7 Recuperar Propuesta Rechazada",
  "description": "Cuando una CorporateProposal cambia a estado \"Rechazada\", IA infiere motivo, arma contraoferta personalizada (descuento + ajustes), crea Tarea para el equipo y env\u00eda guion completo de re-engagement.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Rechazada\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CorporateProposal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ia_recuperar_propuesta_rechazada",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recuperarPropuestaRechazada",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recuperarPropuestaRechazada"
  }
}