{
  "name": "Email cliente \u00b7 Cambio de estado de PedidoWeb",
  "description": "Env\u00eda email HTML al cliente cuando el pedido cambia a Confirmado, En Producci\u00f3n, Listo para Despacho, Despachado o Entregado. En estado Entregado incluye CTA para calificar.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"estado\") != null) and (.trigger.data.estado == \"Confirmado\" or .trigger.data.estado == \"En Producci\\u00f3n\" or .trigger.data.estado == \"Listo para Despacho\" or .trigger.data.estado == \"Despachado\" or .trigger.data.estado == \"Entregado\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PedidoWeb"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_cliente_cambio_de_estado_de_pedidoweb",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onPedidoWebStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onPedidoWebStatusChange"
  }
}