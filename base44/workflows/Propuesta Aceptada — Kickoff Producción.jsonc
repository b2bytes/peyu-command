{
  "name": "Propuesta Aceptada \u2014 Kickoff Producci\u00f3n",
  "description": "Al aceptar una propuesta: env\u00eda email de confirmaci\u00f3n al cliente con pasos de pago, notifica internamente, y crea autom\u00e1ticamente la Orden de Producci\u00f3n.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"Aceptada\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CorporateProposal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "propuesta_aceptada_kickoff_producci_n",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onProposalAccepted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onProposalAccepted"
  }
}